{
  "rewrites": [
    {
      "source": "/art/tarot-site/demo",
      "destination": "https://tarot-coral-gamma.vercel.app/"
    },
    {
      "source": "/art/tarot-site/demo/",
      "destination": "https://tarot-coral-gamma.vercel.app/"
    },
    {
      "source": "/art/tarot-site/demo/:path*",
      "destination": "https://tarot-coral-gamma.vercel.app/:path*"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/rewind/demo",
      "destination": "https://rewind-gray.vercel.app/"
    },
    {
      "source": "/rewind/demo/",
      "destination": "https://rewind-gray.vercel.app/"
    },
    {
      "source": "/rewind/demo/:path*",
      "destination": "https://rewind-gray.vercel.app/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
